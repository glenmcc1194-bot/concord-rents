{
  "redirects": [
    { "source": "/collections", "destination": "/equipment", "permanent": true },
    { "source": "/collections/:path*", "destination": "/equipment", "permanent": true },
    { "source": "/products/:path*", "destination": "/equipment", "permanent": true },
    { "source": "/pages/:path*", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/equipment/category/:slug", "destination": "/equipment/category.html" },
    { "source": "/equipment/:slug", "destination": "/equipment/item.html" }
  ]
}
